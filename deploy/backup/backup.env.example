# Settings for deploy/backup/backup.sh. install.sh copies this to
# /etc/kumaboard/backup.env (root-only); edit it there, not here.

# Backup host as user@host. Required.
KUMABOARD_BACKUP_REMOTE=

# Everything below is optional; the values shown are the defaults.
#KUMABOARD_DATA_DIR=/var/lib/kumaboard
#KUMABOARD_CONFIG=/etc/kumaboard/config.yaml
#KUMABOARD_BACKUP_RECIPIENT_FILE=/etc/kumaboard/backup.age.pub
#KUMABOARD_BACKUP_REMOTE_DIR=backups/kumaboard
#KUMABOARD_BACKUP_SSH_KEY=/root/.ssh/kumaboard_backup
#KUMABOARD_BACKUP_DIR=/var/lib/kumaboard/backup
#KUMABOARD_BACKUP_KEEP=7
